{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BanglaOkkhor",
  "mainBinaryName": "BanglaOkkhor",
  "version": "0.1.4",
  "identifier": "app.banglaokkhor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Bijoy-style Bangla keyboard",
    "longDescription": "Type Bangla anywhere with the Bijoy-style fixed layout. Includes an on-screen keyboard, word suggestions, a floating widget and a Unicode ↔ SutonnyMJ ANSI converter.",
    "copyright": "© BanglaOkkhor contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "icons/tray/*": "tray/" },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "linux": {
      "deb": { "files": { "/usr/lib/udev/rules.d/70-banglaokkhor.rules": "linux/70-banglaokkhor.rules" } },
      "rpm": { "files": { "/usr/lib/udev/rules.d/70-banglaokkhor.rules": "linux/70-banglaokkhor.rules" } }
    },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
